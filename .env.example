# Copy this file to .env and fill in sandbox credentials only.
# Get REST API credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: enables LLM responses. Without it, the local demo assistant still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
